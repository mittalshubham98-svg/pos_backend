# Copy to .env (or export these directly) and adjust for your machine.
# Nothing here is required to run locally — every value has a working default in
# app/config.py — but you should change the admin password and SECRET_KEY before this
# leaves your laptop.

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database ---
# Defaults to ./grocery_b2b.db (SQLite, WAL mode) if unset.
# DATABASE_URL=sqlite:///./grocery_b2b.db

# --- CORS ---
# Defaults to "*" (any origin) for local dev. In production, restrict to your real
# domain(s), comma-separated, e.g.:
# CORS_ORIGINS=https://your-app.up.railway.app

# --- Store letterhead (printed on invoices) ---
STORE_NAME=Pilani Supply Co.
STORE_GSTIN=08ABCDE1234F1Z5
STORE_FSSAI=12222016000123
STORE_ADDRESS=Shop 14, Krishna Market, Pilani 333031, Rajasthan
STORE_PHONE=+91 98280 44120
STORE_UPI_ID=pilanisupply@upi
PLACE_OF_SUPPLY=Rajasthan (08)

# --- OCR ---
# Windows: tesseract.exe usually isn't on PATH. Point this at it explicitly, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANG=eng

# --- Image fetch ---
IMAGE_FETCH_ENABLED=true
IMAGE_FETCH_TIMEOUT_SECONDS=8

# --- PDF generation (WeasyPrint) ---
# WeasyPrint needs native Pango/cairo/GObject libraries. On Windows these come from MSYS2
# (see doc.courtbouillon.org/weasyprint "first steps" -> Windows): install MSYS2, then run
# `pacman -S mingw-w64-x86_64-pango` in its shell. app/config.py auto-detects the default
# C:\msys64\mingw64\bin location; only set this if you installed MSYS2 somewhere else.
# WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin
